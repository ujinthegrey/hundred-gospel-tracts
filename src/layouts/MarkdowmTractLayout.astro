---
import Audioplayer from "../components/Audioplayer.astro"
import BaseLayout from "./BaseLayout.astro"

interface Frops {
  title: string
  description?: string

}
const { frontmatter } = Astro.props
const tags = frontmatter.tags
---

<BaseLayout pageTitle={frontmatter.title}>
    <Audioplayer />
    <slot />
    <div class="info">
      <p>{frontmatter.city},</p>
      <p><time>{frontmatter.pubDate.slice(0,10)}</time></p>
      <ul>
        <h3 class="_hidden-title">Навигация по тегам</h3>
        <div class="container">
          {tags.map((tag) => (<li><a href={`/tags/${tag}`} class="_body-link tag-link">{tag}</a></li>))}
        </div>
      </ul>
    </div>
</BaseLayout>
<style>
  .info {
    margin-block: 2rem;
  }
  p {
    text-align: center;
  }
  .container {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>