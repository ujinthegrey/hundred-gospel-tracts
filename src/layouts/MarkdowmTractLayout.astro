---
import Title from '../components/Title.astro'
import Audioplayer from "../components/Audioplayer.astro"
import FormattedDate from "../components/FormattedDate.astro"
import BaseLayout from "./BaseLayout.astro"

const { frontmatter } = Astro.props
---

<BaseLayout pageTitle={frontmatter.title} tractId={frontmatter.tractId}>
    {frontmatter.audio && <Audioplayer audio={frontmatter.audio} />}
    <div class="background">
      <slot />
      <div class="info">
        <p>{frontmatter.city},</p>
        <p><FormattedDate date={frontmatter.pubDate} /></p>
        <ul>
          <h3 class="_hidden-title">Навигация по тегам</h3>
          <div class="container">
            {frontmatter.tags.map((tag) => (<li><a href={`/tags/${tag}`} class="_body-link tag-link">{tag}</a></li>))}
          </div>
        </ul>
      </div>
    </div>
</BaseLayout>
<style>
  .background {
    background-color: var(--bg-body);
    margin-block: 2rem;
    padding: 2rem 1rem;
  }
  h2 {
    font-size: 2rem;
  }
  .info {
    margin-block: 2rem;
  }
  .info > p {
    text-align: center;
  }
  .container {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>