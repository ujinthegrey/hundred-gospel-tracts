---
import { getCollection } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'
const pageTitle = "Облако Тегов"

const allTracts = await getCollection('tract')
const uniqueTags = [...new Set(allTracts.map((tract) => tract.data.tags).flat())].sort()
---
<BaseLayout pageTitle={pageTitle}>
    <ul>
        <h3 class="_hidden-title">Навигация по тегам</h3>
        <div class="container">
            {uniqueTags.map((tag) => <li class="item"><a class="_body-link" href={`/tags/${tag}`}>{tag}</a></li>)}
        </div>
    </ul>
</BaseLayout>
<style>
    .container {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
    }
    .item {
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;;
    }
    @media (max-width: 840px) {
        .container {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    @media (max-width: 720px) {
        .container {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @media (max-width: 640px) {
        .container {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 480px) {
        .container {
            grid-template-columns: 1fr;
        }
    }
</style>