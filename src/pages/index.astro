---
import { getCollection } from "astro:content"

import BaseLayout from "../layouts/BaseLayout.astro"
import TractItem from "../components/TractItem.astro"

const pageTitle: string = 'Сто Евангельских Трактатов'

const allTracts = await getCollection('tract')
---

<BaseLayout pageTitle={pageTitle}>
	<div class="_grid-container">
		{allTracts.map((tract) => (
			<TractItem tract={tract} url={`/tracts/${tract.slug}/`} title={tract.data.title} />
		))}
	</div>
</BaseLayout>