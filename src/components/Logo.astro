<style>
    a {
        margin-block: 10px;
        display: block;
        width: 96px;
        height: 30px;
        overflow: visible;
    }
    .container {
        display: grid;
        grid-template-columns: repeat(16, 6px);
        grid-template-rows: repeat(5, 6px);
    }
    .item {
        height: 6px;
        width: 6px;
    }
    a:hover > .container,
    a:focus > .container {
        transform: rotate(-3deg);
    }
    a:hover > .container > .item,
    a:focus > .container > .item  {
        border-radius: 50%;
    }
    .empty {
        background-color: transparent;
    }
    .fill {
        background-color: var(--text-header-footer);
    }
    .accent {
        background-color: var(--text-header-footer-accent);
    }

</style>