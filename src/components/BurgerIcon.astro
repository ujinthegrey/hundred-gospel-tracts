<button id="burger-icon">
    <span></span>
    <span></span>
    <span></span>
    <script>
        import '../scripts/burger'
    </script>
</button>
<style>
    button {
        height: 30px;
        width: 30px;
        position: relative;
        cursor: pointer;
        transition: translate .3s ease;
        overflow: visible;
    }
    button:hover,
    button:focus {
        transform: rotate(5deg);
    }
    button:hover > span,
    button:focus > span{
        background-color: var(--text-header-footer-accent);
    }
    button span {
        height: 6px;
        width: 100%;
        background-color: var(--text-header-footer);
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        transition: all .3s ease;
    }
    button span:nth-child(1) {
        top: 10%;
    }
    button span:nth-child(3) {
        top: 90%;
    }
    button.active span {
        width: 120%;
        /* background-color: var(--text-header-footer-accent); */
    }
    button.active span:nth-child(1) {
        top: 50%;
        transform: translate(-50%, -50%) rotate(135deg);
    }
    button.active span:nth-child(2) {
        opacity: 0;
    }
    button.active span:nth-child(3) {
        top: 50%;
        transform: translate(-50%, -50%) rotate(-135deg);
    }
</style>