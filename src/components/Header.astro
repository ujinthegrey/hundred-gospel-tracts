---
import BurgerIcon from "./BurgerIcon.astro"
import BurgerMenu from "./BurgerMenu.astro"
import Logo from "./Logo.astro"

---
<header>
    <div class='_container header-container'>
        <Logo />
        <BurgerIcon />
        <BurgerMenu />
    </div>
    <script>
        import '../scripts/burger'
    </script>
</header>
<style>
    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background-color: var(--bg-header-footer);
        backdrop-filter: blur(15px);
        z-index: 70;
    }
    .header-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
</style>
