---
import BurgerIcon from "./BurgerIcon.astro"
import BurgerMenu from "./BurgerMenu.astro"
import Logo from "./Logo.astro"

---
<header class="blur">
    <div class='_container header-container'>
        <Logo />
        <BurgerIcon />
    </div>
    <script>
        import '../scripts/burger'
    </script>
</header>
<BurgerMenu />
<style>
    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--header-height);
        z-index: 70;
        background-color: var(--bg-header-footer);
        backdrop-filter: blur(15px);
    }
    .header-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
</style>
