---
const { audio } = Astro.props
---
<div>
    <audio preload="auto" controls>
        <source src={audio} type="audio/mpeg">
    </audio>
</div>
<style>
    div {
        background-color: var(--bg-body);
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        min-height: 50px;
        position: sticky;
        z-index: 10;
    }
    audio {
        width: 100%;
    }
</style>