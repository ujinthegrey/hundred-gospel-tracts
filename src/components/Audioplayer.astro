---
const { audio } = Astro.props
---
<div>
    <audio src={audio} preload="auto" controls/>
</div>
<style>
    div {
        position: sticky;
        top: var(--header-heidht);
        background-color: var(--bg-body);
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        min-height: 50px;
        z-index: 10;
    }
    audio {
        width: 100%;
        border-radius: 0px;
    }
</style>