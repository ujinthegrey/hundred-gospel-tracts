---
import ToggleTheme from "./ToggleTheme.astro"
---
<nav id="burger-menu">
    <div class="_container">
        <h3 class='_hidden-title'>Вспомогательная навигация</h3>
        <ul>
            <li><ToggleTheme /></li>
            <li><a href='/about' class="_header-footer-link">о проекте</a></li>
            <li><a href='/tracts/tract-1' class="_header-footer-link">трактат #1</a></li>
            <li><a href='/tags' class="_header-footer-link">теги</a></li>
        </ul>
    </div>
</nav>
<style>
    nav {
        visibility: hidden;
        position: absolute;
        top: var(--header-height);
        left: 200vw;
        right: -200vw;
        transition: .3s ease;
        background-color: var(--bg-header-footer);
        backdrop-filter: blur(15px);
        z-index: 60;
    }
    nav.open {
        visibility: visible;
        left: 0;
        right: 0;
    }
    ul {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 2rem;
    }
</style>