---
import FormattedDate from "./FormattedDate.astro"

const { tract } = Astro.props
const views = Math.floor(Math.random() *170)
---
<a class="atricle-link" href={`/tracts/${tract.slug}`}>
    <article>
        <img class="_img" src={tract.data.image.url} alt={tract.data.image.alt} />
        <div class="info">
            <p class="bible">{tract.data.bible}</p>
            <p class="title">{tract.data.title}</p>
            <p class="author">{tract.data.author}</p>
            <p class="date"><FormattedDate date={tract.data.pubDate} /></p>
            <p class="views">&#128065; {views}</p>
        </div>
    </article>
</a>
<style>
    .atricle-link {
        display: flex;
        cursor: pointer;
        transition: box-shadow .3s ease;
    }
    .atricle-link:hover,
    .atricle-link:focus {
        box-shadow: 0px 0px 10px var(--shadow-body);
    }
    article {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        text-align: center;
        background-color: var(--bg-body);
    }

    .info {
        display: flex;
        flex-direction: column;
        margin: 1rem .5rem 2rem;
    }

    .author,
    .bible {
        color: var(--text-body-accent);
        font-size: 1.2rem;
    }
    .title {
        text-transform: uppercase;
        font-weight: 600;
    }
    .date,
    .views {
        font-size: 1rem;
    }
    .date {
        margin-top: 1rem;
    }

</style>