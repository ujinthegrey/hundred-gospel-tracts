---
const { tract } = Astro.props
---
<article>
    <a class="img-link" href={`/tracts/${tract.slug}`}><img src={tract.data.image.url} alt={tract.data.image.alt}/></a>
    <p class="title">{tract.data.title}</p>
    <p class="author">{tract.data.author}</p>
    <p>{tract.data.pubDate.toISOString().slice(0,10)}</p>
    <!-- <p>{tract.data.tags.join(', ')}</p> -->
</article>
<style>
    article {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        text-align: center;
    }
    .title {
        text-transform: uppercase;
        font-weight: 600;
    }
    .author {
        color: var(--text-body-accent)
    }
    .img-link {
        transition: translate .3s ease;
    }
    .img-link:hover {
        translate: 6px;
    }
</style>