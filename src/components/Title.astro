---
interface Props {
    title: string
}
const {title} = Astro.props
---
<div>
    <h1>{title}</h1>
</div>
<style>
    div {
        width: 100%;
        background-color: var(--bg-body-accent);
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        text-wrap: balance;
        margin-block: 1rem;
        padding: 2rem 1rem;
    }
    h1 {
        font-size: 2.5rem;
        font-weight: 400;
        letter-spacing: .4rem;
        text-transform: uppercase;     
    }
    @media (max-width: 768px) {
    h1 {
        font-size: 2rem;
    }
}
@media (max-width: 640px) {
    h1 {
        font-size: 1.5rem;
    }
}
</style>