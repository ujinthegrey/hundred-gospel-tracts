---
interface Props {
    title: string
    tractId?: number
}
const {title, tractId} = Astro.props
---
<div>
    {tractId && <p class="tract-id">{`Трактат #${tractId}`}</p>}
    <h1>{title}</h1>
</div>
<style>
    div {
        width: 100%;
        background-color: var(--bg-body-accent);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        text-wrap: balance;
        margin-block: 1rem;
        padding: 2rem 1rem;
    }
    .tract-id {
        font-size: 1.2rem;
        font-weight: 800;
        text-transform: lowercase;
        letter-spacing: .5rem;
        opacity: .7;
        margin-bottom: 1rem;
    }
    h1 {
        font-size: 2.5rem;
        font-weight: 400;
        letter-spacing: .4rem;
        text-transform: uppercase;
        text-wrap: wrap;  
    }
    @media (max-width: 768px) {
    h1 {
        font-size: 2rem;
    }
}
@media (max-width: 640px) {
    h1 {
        font-size: 1.4rem;
    }
}
</style>